{
  "name": "clevatess",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI video editor: describe an edit, and it lands on a real timeline you can change by hand.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs --dev && node scripts/serve.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.engine.json"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
