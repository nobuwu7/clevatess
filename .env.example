# Pick ONE way to connect the assistant's model on the server.
# Leave all unset to use only Built-in or From-this-browser modes.

# Shortcuts
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=        # also enables Whisper captions
# GROQ_API_KEY=          # also enables Whisper captions

# Any OpenAI-compatible server (vLLM, llama.cpp, OpenRouter, a self-hosted box...)
# AI_BASE_URL=https://your-server.example.com/v1
# AI_MODEL=your-model
# AI_API_KEY=
# AI_PROVIDER=openai-compatible   # or: anthropic

# Captions: any Whisper-compatible transcription service
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_KEY=
